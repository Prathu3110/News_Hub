{
  "version": 2,
  "builds": [
    { "src": "wsgi.py", "use": "@vercel/python" },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/trending", "dest": "wsgi.py" },
    { "src": "/news", "dest": "wsgi.py" },
    { "src": "/stats", "dest": "wsgi.py" },
    { "src": "/analytics", "dest": "wsgi.py" },
    { "src": "/search", "dest": "wsgi.py" },
    { "src": "/sources", "dest": "wsgi.py" },
    { "src": "/docs", "dest": "wsgi.py" },
    { "src": "/debug", "dest": "wsgi.py" },
    { "src": "/style.css", "dest": "frontend/style.css" },
    { "src": "/script.js", "dest": "frontend/script.js" },
    { "src": "/(.*)", "dest": "frontend/index.html" }
  ]
}
